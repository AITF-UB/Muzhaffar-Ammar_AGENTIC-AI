
QDRANT_HOST=http://76.13.195.1
QDRANT_PORT=6333

LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=your_langsmith_api_key_here

# PILIH PROVIDER LLM: huggingface | bedrock | runpod | kaggle_ollama | kaggle_vllm | tim2_vllm
LLM_PROVIDER=huggingface

# 0. Konfigurasi Hugging Face
HF_TOKEN=your_hf_token_here
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# 1. Konfigurasi Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BEDROCK_ENDPOINT_URL=your_bedrock_endpoint_url
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# 2. Konfigurasi RunPod (OpenAI Compatible)
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_URL=https://api.runpod.io/v1/your_endpoint/v1
RUNPOD_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# 3. Konfigurasi Kaggle / Ngrok
NGROK_KAGGLE_OLLAMA=https://your-ngrok-url.ngrok-free.dev
KAGGLE_OLLAMA_MODEL_ID=qwen3.5:9b
NGROK_KAGGLE_VLLM=https://your-ngrok-url.ngrok-free.dev/v1
KAGGLE_VLLM_MODEL_ID=AITF-SR-02/ub-sr-02-qwen3.5-9b-base-5k-CPT-SFT-v2

# 4. Konfigurasi Tim 2 (vLLM OpenAI-Compatible)
TIM2_VLLM_ENDPOINT=http://<IP_ADDRESS>:10401/v1
TIM2_MODEL_ID=aitf-ub-2026/ub-sr-02-qwen3.5-9b-base-sft-v2
TIM2_TEMPERATURE=0.6

# ==========================================
# KONFIGURASI LLM KHUSUS EVALUATOR (Opsional)
# ==========================================
# Jika tidak di-set, Evaluator akan memakai LLM utama.
# Pilihan: huggingface | openai | bedrock | vllm
# EVAL_LLM_PROVIDER=huggingface
# EVAL_HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# EVAL_LLM_PROVIDER=vllm
# EVAL_VLLM_ENDPOINT=http://<IP_ADDRESS>:10401/v1
# EVAL_VLLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# EVAL_LLM_PROVIDER=openai
# EVAL_OPENAI_API_KEY=sk-xxxx
# EVAL_OPENAI_MODEL_ID=gpt-4o-mini


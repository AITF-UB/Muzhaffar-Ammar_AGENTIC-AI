### EVALUASI ESSAY
POST {{baseUrl}}/siswa/s_001/quiz/essay
Content-Type: application/json

{
  "publish_id": "pub_123",
  "mapel_id": "ips",
  "elemen_id": "sosiologi",
  "elemen_label": "Pemahaman Sosial",
  "materi": "Gejala Sosial",
  "materi_id": "ips__gejala_sosial",
  "level": "Mid",
  "soal": {
    "e1": "Berikan satu contoh gejala sosial di lingkungan sekitarmu dan jelaskan dampaknya!"
  },
  "rubrik": {
    "e1": "Siswa menyebutkan masalah nyata (seperti kemiskinan atau pengangguran) dan memberikan analisis sebab-akibat struktural."
  },
  "jawaban": {
    "e1": "Menurut saya, kemiskinan adalah contoh gejala sosial karena dipengaruhi oleh struktur ekonomi masyarakat secara luas dan bukan sekadar masalah individu malas."
  }
}

### EVALUASI ESSAY - Matematika Trigonometri
POST {{baseUrl}}/siswa/s_001/quiz/essay
Content-Type: application/json

{
  "publish_id": "pub_456",
  "mapel_id": "mat",
  "elemen_id": "geometri",
  "elemen_label": "Geometri",
  "materi": "Pemanfaatan Perbandingan Trigonometri",
  "materi_id": "mat__pemanfaatan_trigonometri",
  "level": "Mid",
  "soal": {
    "e1": "Seorang pengamat berdiri 10 meter dari kaki sebuah pohon dan melihat puncak pohon dengan sudut elevasi 30 derajat. Jika tinggi pengamat diabaikan, jelaskan langkah dan rumus perbandingan trigonometri yang tepat untuk menentukan tinggi pohon tersebut!"
  },
  "rubrik": {
    "e1": "Siswa harus mengidentifikasi bahwa perbandingan yang tepat adalah tangen (tan 30 derajat = depan/samping = tinggi pohon/jarak), lalu menghitung tinggi pohon = 10 * tan 30 = 10 * (1/sqrt(3)) atau sekitar 5.77 meter."
  },
  "jawaban": {
    "e1": "Untuk mencari tinggi pohon, kita memakai perbandingan tangen karena yang diketahui adalah jarak mendatar (sisi samping = 10m) dan yang dicari adalah tinggi pohon (sisi depan). Rumusnya tan(30) = depan / samping. Maka depan = samping * tan(30) = 10 * (1/3 * akar(3)) = 10/3 akar(3) meter atau sekitar 5.77 meter."
  }
}

